<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unity で使えるように、netstandard2.1・C# 9 に固定する（DomainCore.Tests の ToolchainTests が検査する） -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
  </PropertyGroup>

  <!-- 単体テストから内部の関数（イベントの当たりの選び方・満足度の計算）を直接確かめるため。公開の API には含めない -->
  <ItemGroup>
    <InternalsVisibleTo Include="DomainCore.Tests" />
  </ItemGroup>

</Project>
