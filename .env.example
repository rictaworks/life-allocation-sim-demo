# 環境変数の名前だけを書く。値は書かない。実際の値は .env（コミットされない）か、Railway・Vercel の Variables に入れる。
# Rails は src/backend/.env を読む（dotenv-rails。development・test のときだけ）。本番は .env を読まず、環境変数で渡す。

# Rails の環境（development / test / production）。未設定は production として起動する。
RAILS_ENV=

# アプリの環境（development のときだけ開発用の分岐）。RAILS_ENV が development のときは、APP_ENV も development にする（片方だけなら起動しない）。未設定・不明な値は本番として扱う。
APP_ENV=

# Rails の秘密鍵（64 文字以上）。未設定なら起動しない。
SECRET_KEY_BASE=

# SQLite のファイルの場所（絶対パス。Railway のボリューム上）。未設定なら起動しない。
DATABASE_PATH=

# 公開するオリジン（scheme://ホスト[:ポート]。保存 API は Origin ヘッダーと完全一致で比べ、Host はこのオリジンのホストだけを受け付ける）。未設定なら起動しない。
APP_ORIGIN=

# サーバー側の再計算に使う .NET ホストの DLL の場所
CORE_HOST_DLL=

# 任意（設定するときだけ値を入れる。空のまま書かない）：config/server.yml の既定値を上書きする。
# RAILS_MAX_THREADS（Puma のスレッド数と SQLite の接続数）・PORT（待ち受けポート）・RAILS_LOG_LEVEL（本番のログの水準）

