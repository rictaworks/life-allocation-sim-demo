# --- Secrets（最優先・コミット事故の再発防止） ---
.env
.env.*
!.env.example
config/master.key
**/config/master.key
**/config/credentials/*.key
*.pem
*.key
!*.pub.key

# --- .claude/ の扱いはリポジトリの公開設定で決める ---
# PUBLICリポジトリ：以下を有効化し、.claude/を丸ごと除外する（社内ノウハウの公開防止。questboardで実施済み）
.claude/*
#
# PRIVATEリポジトリ：上の行をコメントアウトし、.claude/を丸ごとコミットする
# （露出リスクが無く、クローン直後からsettings.json・agents・workflowsが動く。x-follower-gateで実施済み）

# --- ノウハウ・非公開ディレクトリ（公開/非公開に関わらず常に除外） ---
CLIENT/
DEBUG/
TASKS/
WORK/
DELETE/
ENV/

# --- Rails ---
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
.byebug_history
/public/assets

# --- Node / Next.js / Vercel ---
node_modules/
.next/
out/
.vercel

# --- Python / FastAPI ---
__pycache__/
*.pyc
.venv/
venv/

# --- Go ---
/bin/

# --- Rust / Tauri ---
target/
src-tauri/target/

# --- Unity ---
/Library/
/Temp/
/Obj/
/Build/
/Logs/
/UserSettings/
/MemoryCaptures/
*.csproj
*.sln
# 上の / 付きの行はルート固定のため、src/unity と src/web/unity の生成物はここで範囲を明示する
src/unity/Library/
src/unity/Temp/
src/unity/Obj/
src/unity/Logs/
src/unity/UserSettings/
src/unity/Build/
src/unity/MemoryCaptures/
# Domain Core の DLL（コピーして使う。コミットしない）。DLL のフォルダの中の .meta も、この行で除外される
# Assets 配下の .meta は GUID を含むため Git に載せる。除外するのは上の DLL のフォルダだけ
src/unity/Assets/Plugins/DomainCore/
# WebGL のビルド出力（Build・TemplateData・StreamingAssets）
src/web/unity/

# --- Playwright ---
test-results/
playwright-report/
/.playwright-mcp/

# --- エディタ・OS ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*Zone.Identifier

# --- テスト・カバレッジ ---
coverage/
.rspec_status

# --- .NET（Domain Core・再計算ホスト。範囲を src/core と src/core-host に限定する） ---
# 裸の bin/ にすると src/backend/bin/（Rails の bin スタブ）まで除外されるため、範囲を絞る
src/core/**/bin/
src/core/**/obj/
src/core-host/**/bin/
src/core-host/**/obj/
# 上の Unity 向けの *.csproj の除外から、.NET のプロジェクトファイルだけを外す
!src/core/**/*.csproj
!src/core-host/**/*.csproj
